<Window x:Class="VrcOscAutomator.Views.HotkeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:VrcOscAutomator.Converters"
        Title="ホットキー設定"
        Width="400" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <StackPanel Margin="16">

        <!-- 開始 -->
        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="開始" VerticalAlignment="Center" />
            <TextBox Grid.Column="1"
                     Text="{Binding StartDisplayText, Mode=OneWay}"
                     IsReadOnly="True"
                     VerticalAlignment="Center"
                     Margin="4,0"
                     Padding="4,3">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsListeningStart}" Value="True">
                                <Setter Property="Background" Value="#FFF8DC" />
                                <Setter Property="Foreground" Value="#888800" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
            <Button Grid.Column="2"
                    Content="..."
                    Command="{Binding ListenStartCommand}"
                    Width="28" Height="24" MinWidth="0" Padding="0"
                    Margin="2,0" />
            <Button Grid.Column="3"
                    Content="×"
                    Command="{Binding ClearStartCommand}"
                    Width="28" Height="24" MinWidth="0" Padding="0"
                    Margin="2,0" />
        </Grid>

        <!-- 一時停止/再開 -->
        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="一時停止" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1"
                     Text="{Binding PauseDisplayText, Mode=OneWay}"
                     IsReadOnly="True"
                     VerticalAlignment="Center"
                     Margin="4,0"
                     Padding="4,3">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsListeningPause}" Value="True">
                                <Setter Property="Background" Value="#FFF8DC" />
                                <Setter Property="Foreground" Value="#888800" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
            <Button Grid.Column="2"
                    Content="..."
                    Command="{Binding ListenPauseCommand}"
                    Width="28" Height="24" MinWidth="0" Padding="0"
                    Margin="2,0" />
            <Button Grid.Column="3"
                    Content="×"
                    Command="{Binding ClearPauseCommand}"
                    Width="28" Height="24" MinWidth="0" Padding="0"
                    Margin="2,0" />
        </Grid>

        <!-- 停止 -->
        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="停止" VerticalAlignment="Center" />
            <TextBox Grid.Column="1"
                     Text="{Binding StopDisplayText, Mode=OneWay}"
                     IsReadOnly="True"
                     VerticalAlignment="Center"
                     Margin="4,0"
                     Padding="4,3" >
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsListeningStop}" Value="True">
                                <Setter Property="Background" Value="#FFF8DC" />
                                <Setter Property="Foreground" Value="#888800" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
            <Button Grid.Column="2"
                    Content="..."
                    Command="{Binding ListenStopCommand}"
                    Width="28" Height="24" MinWidth="0" Padding="0"
                    Margin="2,0" />
            <Button Grid.Column="3"
                    Content="×"
                    Command="{Binding ClearStopCommand}"
                    Width="28" Height="24" MinWidth="0" Padding="0"
                    Margin="2,0" />
        </Grid>

        <TextBlock Text="Escを押すとキャンセルします。"
                   FontSize="11"
                   Margin="0,8,0,0"
                   Visibility="{Binding IsListening, Converter={StaticResource BoolToVisibilityConverter}}" />

        <!-- OK / キャンセル -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="OK"
                    Width="80" Margin="0,0,8,0"
                    IsDefault="True"
                    Click="OkButton_Click" />
            <Button Content="キャンセル"
                    Width="80"
                    IsCancel="True"
                    Click="CancelButton_Click" />
        </StackPanel>

    </StackPanel>
</Window>
