<UserControl x:Class="VrcOscAutomator.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:VrcOscAutomator.Converters"
             xmlns:vm="clr-namespace:VrcOscAutomator.ViewModels"
             xmlns:b="clr-namespace:VrcOscAutomator.Behaviors">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:FloatToIntBoolConverter x:Key="IntValueToBoolConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ========== シーケンス DataGrid ========== -->
        <DataGrid Grid.Column="0"
                  ItemsSource="{Binding Slots}"
                  SelectedItem="{Binding SelectedSlot}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  RowDetailsVisibilityMode="VisibleWhenSelected"
                  Margin="4">

            <!-- ========== アコーディオン展開パネル ========== -->
            <DataGrid.RowDetailsTemplate>
                <DataTemplate DataType="{x:Type vm:SequenceSlotViewModel}">
                    <Border Background="#F0F4FA"
                            BorderBrush="#7B9FD4" BorderThickness="3,0,0,0"
                            Padding="20,10,12,12"
                            Margin="24,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <StackPanel>

                            <!-- Float軸プリセット: -1〜+1 スライダー -->
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding SelectedPreset.IsBuiltinFloat, Converter={StaticResource BoolToVis}}"
                                        VerticalAlignment="Center">
                                <TextBlock Text="値:"
                                           Width="36" VerticalAlignment="Center"
                                           Foreground="#444" />
                                <Slider Width="220" Minimum="-1.0" Maximum="1.0"
                                        SmallChange="0.05" LargeChange="0.1"
                                        Value="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                        VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding Value, StringFormat=F2}"
                                           Width="40" VerticalAlignment="Center"
                                           FontWeight="SemiBold" />
                            </StackPanel>

                            <!-- Int定義済みプリセット: ON/OFF ラジオボタン -->
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding SelectedPreset.IsBuiltinInt, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="値:" Width="36"
                                           VerticalAlignment="Center" Foreground="#444" />
                                <RadioButton Content="1 (ON)" Margin="0,0,12,0"
                                             IsChecked="{Binding Value, Converter={StaticResource IntValueToBoolConverter}, ConverterParameter=1}" />
                                <RadioButton Content="0 (OFF)"
                                             IsChecked="{Binding Value, Converter={StaticResource IntValueToBoolConverter}, ConverterParameter=0}" />
                            </StackPanel>

                            <!-- カスタム: OSCアドレス + 型選択 + 値 -->
                            <StackPanel Visibility="{Binding SelectedPreset.IsCustom, Converter={StaticResource BoolToVis}}">

                                <!-- 行1: アドレス + 型選択 -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="OSCアドレス:"
                                               VerticalAlignment="Center" Foreground="#444" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding CustomAddress, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" />
                                    <TextBlock Grid.Column="3" Text="型:"
                                               VerticalAlignment="Center" Foreground="#444" />
                                    <ComboBox Grid.Column="4"
                                              ItemsSource="{Binding AvailableValueTypes}"
                                              SelectedItem="{Binding CustomValueType, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center" />
                                </Grid>

                                <!-- 行2a: Float モード — 数値入力 -->
                                <Grid Visibility="{Binding IsFloatMode, Converter={StaticResource BoolToVis}}"
                                      Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="値:"
                                               VerticalAlignment="Center" Foreground="#444" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalAlignment="Center"
                                             b:NumericTextBoxBehavior.RefreshOnLostFocus="True" />
                                </Grid>

                                <!-- 行2b: Int モード — 数値入力 -->
                                <Grid Visibility="{Binding IsIntMode, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="値:"
                                               VerticalAlignment="Center" Foreground="#444" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalAlignment="Center"
                                             b:NumericTextBoxBehavior.RefreshOnLostFocus="True" />
                                </Grid>

                                <!-- 行2c: Bool モード — チェックボックス -->
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsBoolMode, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="値:" Width="96"
                                               VerticalAlignment="Center" Foreground="#444" />
                                    <CheckBox IsChecked="{Binding BoolValue, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- 行2d: String モード — テキスト入力 -->
                                <Grid Visibility="{Binding IsStringMode, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="値:"
                                               VerticalAlignment="Center" Foreground="#444" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding StringValue, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalAlignment="Center" />
                                </Grid>

                            </StackPanel>

                            <!-- 待機: パラメータなし -->
                            <TextBlock Text="(パラメータなし)"
                                       Foreground="#888" FontStyle="Italic"
                                       Visibility="{Binding SelectedPreset.IsWait, Converter={StaticResource BoolToVis}}" />

                            <!-- 繰り返し開始: 回数入力 -->
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding SelectedPreset.IsLoopBegin, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="繰り返し回数:" Width="96"
                                           VerticalAlignment="Center" Foreground="#444" />
                                <TextBox Text="{Binding RepeatCount, UpdateSourceTrigger=PropertyChanged}"
                                         Width="60" VerticalAlignment="Center"
                                         b:NumericTextBoxBehavior.RefreshOnLostFocus="True"
                                         b:NumericTextBoxBehavior.MinValue="0" />
                                <TextBlock Text="回" Margin="6,0,0,0"
                                           VerticalAlignment="Center" Foreground="#444" />
                            </StackPanel>

                            <!-- 繰り返し終了: パラメータなし -->
                            <TextBlock Text="(パラメータなし)"
                                       Foreground="#888" FontStyle="Italic"
                                       Visibility="{Binding SelectedPreset.IsLoopEnd, Converter={StaticResource BoolToVis}}" />


                        </StackPanel>

                            <!-- 値の書き戻し (通常スロットのみ) -->
                            <CheckBox Content="完了後に 0 に戻す"
                                      IsChecked="{Binding ResetOnComplete, UpdateSourceTrigger=PropertyChanged}"
                                      VerticalAlignment="Center"
                                      Margin="12,0,0,0"
                                      Visibility="{Binding ShowResetOption, Converter={StaticResource BoolToVis}}" />

                        </StackPanel>
                    </Border>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                            <Setter Property="Background" Value="#FFDDDD" />
                            <Setter Property="ToolTip" Value="OSCアドレスが無効です。'/' で始まるアドレスを入力してください。" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>

                <!-- ● 現在実行中インジケータ (緑ポチ) -->
                <DataGridTemplateColumn Width="24" CanUserResize="False" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:SequenceSlotViewModel}">
                            <Ellipse Width="10" Height="10"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Visibility="{Binding IsCurrentSlot, Converter={StaticResource BoolToVis}}">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#00C853" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsPaused,
                                                                           RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Value="True">
                                                <Setter Property="Fill" Value="#F5A800" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- コマンド (プリセット選択) -->
                <DataGridTemplateColumn Header="コマンド" Width="120" SortMemberPath="SelectedPreset.Name">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:SequenceSlotViewModel}">
                            <TextBlock Text="{Binding SelectedPreset.Name}"
                                       VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate DataType="{x:Type vm:SequenceSlotViewModel}">
                            <ComboBox ItemsSource="{Binding AvailablePresets}"
                                      SelectedItem="{Binding SelectedPreset, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="Name" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- 時間 (ms) — ループマーカーには非表示 -->
                <DataGridTemplateColumn Header="時間 (ms)" Width="90" SortMemberPath="DurationMs">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:SequenceSlotViewModel}">
                            <TextBlock VerticalAlignment="Center" Margin="4,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding DurationMs}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDurationEditable}" Value="False">
                                                <Setter Property="Text" Value="—" />
                                                <Setter Property="Foreground" Value="#888" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate DataType="{x:Type vm:SequenceSlotViewModel}">
                            <Grid>
                                <TextBox Text="{Binding DurationMs, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding IsDurationEditable, Converter={StaticResource BoolToVis}}"
                                         b:NumericTextBoxBehavior.RefreshOnLostFocus="True"
                                         b:NumericTextBoxBehavior.MinValue="0" />
                                <TextBlock Text="—" Foreground="#888" VerticalAlignment="Center" Margin="4,0"
                                           Visibility="{Binding IsDurationEditable, Converter={StaticResource InverseBoolToVis}}" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- パラメータ サマリー -->
                <DataGridTemplateColumn Header="パラメータ" Width="*" SortMemberPath="ParameterSummary"
                                        IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:SequenceSlotViewModel}">
                            <TextBlock Text="{Binding ParameterSummary}"
                                       VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- ========== 操作ボタン ========== -->
        <StackPanel Grid.Column="1"
                    Orientation="Vertical"
                    VerticalAlignment="Top"
                    Margin="4">
            <Button Content="追加"
                    Command="{Binding AddSlotCommand}"
                    Margin="0,2" />
            <Button Content="コピー"
                    Command="{Binding CopySlotCommand}"
                    Margin="0,2" />
            <Button Content="削除"
                    Command="{Binding RemoveSlotCommand}"
                    Margin="0,2" />
            <Separator Margin="0,4" />
            <Button Content="上へ"
                    Command="{Binding MoveUpCommand}"
                    Margin="0,2" />
            <Button Content="下へ"
                    Command="{Binding MoveDownCommand}"
                    Margin="0,2" />
            <Separator Margin="0,4" />
            <Button Content="エクスポート"
                    Command="{Binding ExportCommand}"
                    Margin="0,2" />
            <Button Content="インポート"
                    Command="{Binding ImportCommand}"
                    Margin="0,2" />
        </StackPanel>

    </Grid>
</UserControl>
