<Window x:Class="VrcOscAutomator.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VrcOscAutomator.ViewModels"
        xmlns:views="clr-namespace:VrcOscAutomator.Views"
        xmlns:models="clr-namespace:VrcOscAutomator.Models"
        Title="{Binding WindowTitle}"
        Height="400" Width="600"
        ResizeMode="NoResize">

<DockPanel>

        <!-- ===== 上部: メニューバー ===== -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="終了(_X)" Command="{Binding CloseCommand}" />
            </MenuItem>
            <MenuItem Header="操作(_O)">
                <MenuItem Header="開始(_S)"
                          Command="{Binding StartCommand}" />
                <MenuItem Command="{Binding PauseResumeCommand}">
                    <MenuItem.Style>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="一時停止(_P)" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                    <Setter Property="Header" Value="再開(_P)" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>
                <MenuItem Header="停止(_T)"
                          Command="{Binding StopCommand}" />
            </MenuItem>
            <MenuItem Header="オプション(_N)">
                <MenuItem Header="送信先設定(_D)..."
                          Command="{Binding OpenTargetsWindowCommand}"
                          IsEnabled="{Binding IsNotPlaying}" />
                <MenuItem Header="ホットキー設定(_H)..."
                          Command="{Binding OpenHotkeySettingsCommand}"
                          IsEnabled="{Binding IsNotPlaying}" />
                <MenuItem Header="キーリピート設定(_R)..."
                          Command="{Binding OpenKeyRepeatSettingsCommand}"
                          IsEnabled="{Binding IsNotPlaying}" />
                <Separator />
                <MenuItem Header="キーボード入力モード(_K)">
                    <MenuItem Header="VKコード" IsCheckable="True"
                              IsChecked="{Binding IsKeyboardVkMode, Mode=OneWay}"
                              Command="{Binding SetKeyboardModeCommand}"
                              CommandParameter="{x:Static models:KeyboardInputMode.VirtualKey}" />
                    <MenuItem Header="スキャンコード" IsCheckable="True"
                              IsChecked="{Binding IsKeyboardScanMode, Mode=OneWay}"
                              Command="{Binding SetKeyboardModeCommand}"
                              CommandParameter="{x:Static models:KeyboardInputMode.ScanCode}" />
                </MenuItem>
                <MenuItem Header="マウス入力モード(_M)">
                    <MenuItem Header="標準" IsCheckable="True"
                              IsChecked="{Binding IsMouseStandardMode, Mode=OneWay}"
                              Command="{Binding SetMouseModeCommand}"
                              CommandParameter="{x:Static models:MouseInputMode.Standard}" />
                    <MenuItem Header="仮想" IsCheckable="True"
                              IsChecked="{Binding IsMouseVirtualDesktopMode, Mode=OneWay}"
                              Command="{Binding SetMouseModeCommand}"
                              CommandParameter="{x:Static models:MouseInputMode.VirtualDesktop}" />
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- ===== 最下部: ステータスバー ===== -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#CC0000" />
            </StatusBarItem>
        </StatusBar>

        <!-- ===== 下部: 再生コントロール ===== -->
        <Border DockPanel.Dock="Bottom"
                BorderBrush="#DDDDDD" BorderThickness="0,1,0,0"
                Padding="8,6">
            <DockPanel>
                <CheckBox DockPanel.Dock="Left"
                          Content="ループ再生"
                          IsChecked="{Binding IsLoopMode}"
                          IsEnabled="{Binding IsNotPlaying}"
                          VerticalAlignment="Center"
                          Margin="0,0,16,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="開始"
                            Command="{Binding StartCommand}"
                            Width="90" Margin="4,0" />
                    <Button Command="{Binding PauseResumeCommand}"
                            Width="100" Margin="4,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="一時停止" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                        <Setter Property="Content" Value="再開" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="停止"
                            Command="{Binding StopCommand}"
                            Width="90" Margin="4,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== 中央: プロファイル タブ ===== -->
        <TabControl ItemsSource="{Binding Profiles}"
                    SelectedIndex="{Binding SelectedProfileIndex}">

            <!-- タブヘッダー -->
            <TabControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
                    <TextBlock Text="{Binding Name}" Padding="4,2" />
                </DataTemplate>
            </TabControl.ItemTemplate>

            <!-- タブコンテンツ: ProfileView を IsNotPlaying でロック -->
            <TabControl.ContentTemplate>
                <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
                    <views:ProfileView DataContext="{Binding}"
                                       IsEnabled="{Binding DataContext.IsNotPlaying,
                                                           RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTemplate>
            </TabControl.ContentTemplate>

        </TabControl>

    </DockPanel>
</Window>
