<Window x:Class="VrcOscAutomator.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VrcOscAutomator.ViewModels"
        xmlns:views="clr-namespace:VrcOscAutomator.Views"
        xmlns:models="clr-namespace:VrcOscAutomator.Models"
        xmlns:conv="clr-namespace:VrcOscAutomator.Converters"
        Title="{Binding WindowTitle}"
        Height="400" Width="600"
        ResizeMode="NoResize">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />

        <Style x:Key="TabAddButtonStyle" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Margin" Value="2,0,2,0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Padding="8,0"
                                Background="Transparent"
                                BorderBrush="#AAAAAA"
                                BorderThickness="1,0,0,0">
                            <TextBlock Text="+"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#555555" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0E0E0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C0C0C0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabCloseButtonStyle" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Width="15" Height="15"
                                CornerRadius="2"
                                Background="Transparent">
                            <TextBlock Text="×"
                                       FontSize="9"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C0C0C0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#909090" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- スリムスクロールバー用スタイル群 -->
        <Style x:Key="SlimScrollBarPageButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimScrollBarThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd"
                                Background="#B0B0B0"
                                CornerRadius="3"
                                Margin="0,1" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#808080" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#505050" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimHorizontalScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Border Background="#E0E0E0" CornerRadius="3" />
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SlimScrollBarPageButton}"
                                                  Command="ScrollBar.PageLeftCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SlimScrollBarThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SlimScrollBarPageButton}"
                                                  Command="ScrollBar.PageRightCommand" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabStripScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter Grid.Row="0" />
                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Grid.Row="1"
                                       Orientation="Horizontal"
                                       Minimum="0"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Value="{TemplateBinding HorizontalOffset}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                       Style="{StaticResource SlimHorizontalScrollBarStyle}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- スクロール可能タブ + ＋ボタン付き TabControl ControlTemplate -->
        <Style x:Key="ScrollableTabControlStyle" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- タブストリップ: スクロール領域 + ＋ボタン -->
                            <DockPanel Grid.Row="0" LastChildFill="True">
                                <Button DockPanel.Dock="Right"
                                        Style="{StaticResource TabAddButtonStyle}"
                                        Command="{Binding DataContext.AddProfileCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="プロファイルを追加" />
                                <ScrollViewer x:Name="TabStripScrollViewer"
                                              Style="{StaticResource TabStripScrollViewerStyle}"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled">
                                    <TabPanel x:Name="HeaderPanel"
                                              IsItemsHost="True"
                                              KeyboardNavigation.TabIndex="1"
                                              Background="Transparent" />
                                </ScrollViewer>
                            </DockPanel>

                            <!-- コンテンツエリア -->
                            <Border Grid.Row="1"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{TemplateBinding Background}"
                                    KeyboardNavigation.TabNavigation="Local"
                                    KeyboardNavigation.DirectionalNavigation="Contained"
                                    KeyboardNavigation.TabIndex="2">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  Margin="{TemplateBinding Padding}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

<DockPanel>

        <!-- ===== 上部: メニューバー ===== -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="終了(_X)" Command="{Binding CloseCommand}" />
            </MenuItem>
            <MenuItem Header="操作(_O)">
                <MenuItem Header="開始(_S)"
                          Command="{Binding StartCommand}" />
                <MenuItem Command="{Binding PauseResumeCommand}">
                    <MenuItem.Style>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="一時停止(_P)" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                    <Setter Property="Header" Value="再開(_P)" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>
                <MenuItem Header="停止(_T)"
                          Command="{Binding StopCommand}" />
            </MenuItem>
            <MenuItem Header="オプション(_N)">
                <MenuItem Header="送信先設定(_D)..."
                          Command="{Binding OpenTargetsWindowCommand}"
                          IsEnabled="{Binding IsNotPlaying}" />
                <MenuItem Header="ホットキー設定(_H)..."
                          Command="{Binding OpenHotkeySettingsCommand}"
                          IsEnabled="{Binding IsNotPlaying}" />
                <MenuItem Header="キーリピート設定(_R)..."
                          Command="{Binding OpenKeyRepeatSettingsCommand}"
                          IsEnabled="{Binding IsNotPlaying}" />
                <Separator />
                <MenuItem Header="キーボード入力モード(_K)">
                    <MenuItem Header="VKコード" IsCheckable="True"
                              IsChecked="{Binding IsKeyboardVkMode, Mode=OneWay}"
                              Command="{Binding SetKeyboardModeCommand}"
                              CommandParameter="{x:Static models:KeyboardInputMode.VirtualKey}" />
                    <MenuItem Header="スキャンコード" IsCheckable="True"
                              IsChecked="{Binding IsKeyboardScanMode, Mode=OneWay}"
                              Command="{Binding SetKeyboardModeCommand}"
                              CommandParameter="{x:Static models:KeyboardInputMode.ScanCode}" />
                </MenuItem>
                <MenuItem Header="マウス入力モード(_M)">
                    <MenuItem Header="標準" IsCheckable="True"
                              IsChecked="{Binding IsMouseStandardMode, Mode=OneWay}"
                              Command="{Binding SetMouseModeCommand}"
                              CommandParameter="{x:Static models:MouseInputMode.Standard}" />
                    <MenuItem Header="仮想" IsCheckable="True"
                              IsChecked="{Binding IsMouseVirtualDesktopMode, Mode=OneWay}"
                              Command="{Binding SetMouseModeCommand}"
                              CommandParameter="{x:Static models:MouseInputMode.VirtualDesktop}" />
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- ===== 最下部: ステータスバー ===== -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#CC0000" />
            </StatusBarItem>
        </StatusBar>

        <!-- ===== 下部: 再生コントロール ===== -->
        <Border DockPanel.Dock="Bottom"
                BorderBrush="#DDDDDD" BorderThickness="0,1,0,0"
                Padding="8,6">
            <DockPanel>
                <CheckBox DockPanel.Dock="Left"
                          Content="ループ再生"
                          IsChecked="{Binding IsLoopMode}"
                          IsEnabled="{Binding IsNotPlaying}"
                          VerticalAlignment="Center"
                          Margin="0,0,16,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="開始"
                            Command="{Binding StartCommand}"
                            Width="90" Margin="4,0" />
                    <Button Command="{Binding PauseResumeCommand}"
                            Width="100" Margin="4,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="一時停止" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                        <Setter Property="Content" Value="再開" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="停止"
                            Command="{Binding StopCommand}"
                            Width="90" Margin="4,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== 中央: プロファイル タブ ===== -->
        <TabControl ItemsSource="{Binding Profiles}"
                    SelectedIndex="{Binding SelectedProfileIndex}"
                    Style="{StaticResource ScrollableTabControlStyle}"
                    x:Name="ProfileTabControl"
                    PreviewMouseWheel="TabControl_PreviewMouseWheel">

            <!-- タブヘッダー: リネーム + 削除ボタン -->
            <TabControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
                    <Grid>
                        <!-- 通常表示 -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVis}}"
                                    MouseLeftButtonDown="TabHeader_MouseLeftButtonDown">
                            <TextBlock Text="{Binding Name}" Padding="2,0" VerticalAlignment="Center" />
                            <Button Style="{StaticResource TabCloseButtonStyle}"
                                    Command="{Binding DataContext.DeleteProfileCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="このプロファイルを削除" />
                        </StackPanel>
                        <!-- リネームモード -->
                        <TextBox MaxLength="30"
                                 MinWidth="60"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"
                                 VerticalAlignment="Center">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <EventSetter Event="Loaded"    Handler="RenameTextBox_Loaded" />
                                    <EventSetter Event="LostFocus" Handler="RenameTextBox_LostFocus" />
                                    <EventSetter Event="KeyDown"   Handler="RenameTextBox_KeyDown" />
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </DataTemplate>
            </TabControl.ItemTemplate>

            <!-- タブコンテンツ: ProfileView を IsNotPlaying でロック -->
            <TabControl.ContentTemplate>
                <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
                    <views:ProfileView DataContext="{Binding}"
                                       IsEnabled="{Binding DataContext.IsNotPlaying,
                                                           RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTemplate>
            </TabControl.ContentTemplate>

        </TabControl>

    </DockPanel>
</Window>
