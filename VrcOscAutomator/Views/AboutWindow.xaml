<Window x:Class="VrcOscAutomator.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="バージョン情報"
        Width="340" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="24,20,24,16">

        <TextBlock Text="VRChat OSC Automator"
                   FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,6" />

        <TextBlock x:Name="VersionText"
                   FontSize="12" Foreground="#555"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,4" />

        <TextBlock Text="© 2026 njm2360"
                   FontSize="11" Foreground="#777"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20" />

        <Separator Margin="0,0,0,12" />

        <Button Content="GitHub"
                Click="GitHubButton_Click"
                HorizontalAlignment="Center"
                Width="80" Margin="0,0,0,12" />

        <Button Content="閉じる"
                IsCancel="True"
                IsDefault="True"
                HorizontalAlignment="Center"
                Width="80" />

    </StackPanel>
</Window>
