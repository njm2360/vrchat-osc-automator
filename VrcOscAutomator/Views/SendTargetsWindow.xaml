<Window x:Class="VrcOscAutomator.Views.SendTargetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VrcOscAutomator.ViewModels"
        xmlns:b="clr-namespace:VrcOscAutomator.Behaviors"
        Title="送信先設定"
        Width="480" Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <DockPanel Margin="10">

        <!-- ===== ボタン列 (右) ===== -->
        <StackPanel DockPanel.Dock="Right"
                    Orientation="Vertical"
                    VerticalAlignment="Top"
                    Margin="8,0,0,0">
            <Button Content="追加"
                    Command="{Binding AddTargetCommand}"
                    Width="72" Margin="0,2" />
            <Button Content="削除"
                    Command="{Binding RemoveTargetCommand}"
                    Width="72" Margin="0,2" />
        </StackPanel>

        <!-- ===== 閉じる / キャンセル (下) ===== -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">
            <Button Content="閉じる"
                    Width="80"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="ApplyButton_Click" />
            <Button Content="キャンセル"
                    Width="80"
                    IsCancel="True"
                    Click="CancelButton_Click" />
        </StackPanel>

        <!-- ===== 送信先一覧 DataGrid ===== -->
        <DataGrid ItemsSource="{Binding Targets}"
                  SelectedItem="{Binding SelectedTarget}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>

                <!-- 有効チェック -->
                <DataGridTemplateColumn Header="有効" Width="44" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:OscTargetViewModel}">
                            <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- IP アドレス -->
                <DataGridTextColumn Header="IPアドレス"
                                    Binding="{Binding IpAddress, UpdateSourceTrigger=LostFocus}"
                                    Width="*" />

                <!-- ポート -->
                <DataGridTextColumn Header="ポート"
                                    Binding="{Binding Port, UpdateSourceTrigger=LostFocus}"
                                    Width="80">
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="b:NumericTextBoxBehavior.MinValue" Value="1" />
                            <Setter Property="b:NumericTextBoxBehavior.MaxValue" Value="65535" />
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>

            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>
